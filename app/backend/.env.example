DATABASE_URL=sakuravel:password@tcp(localhost:3306)/sakuravel?parseTime=true&charset=utf8mb4
PORT=8080

# 別オリジンのフロントエンドから叩く場合に設定する
ALLOWED_ORIGIN=http://localhost:3000
# true にするとセッションCookieに Secure + SameSite=None を付ける
COOKIE_SECURE=false

# DB接続プール（省略時は max_open=20 / max_idle=10）。
# DBへの接続数の合計は インスタンス数 × DB_MAX_OPEN_CONNS になるため、
# インスタンスを増やす場合は DB 側の max_connections に収まるよう調整する。
DB_MAX_OPEN_CONNS=20
DB_MAX_IDLE_CONNS=10

# SSE 配信のために DB を確認する間隔（ミリ秒、省略時は 1000）。
# 短くするほど通知は速くなるが、その分 DB への問い合わせが増える。
FANOUT_INTERVAL_MS=1000
