# 最初にこのファイルをコピーして編集します
# cp secret.auto.tfvars.example secret.auto.tfvars

# データベースのパスワード(データベース作成とデータベース接続時に使用)
# 1PasswordのDBパスワードからコピーします
db_password = "YOUR_DB_PASSWORD"


# サービスプリンシパルのID
service_principal_id = ""

# AppRun 専有型の公開ドメイン。LBがHostヘッダで振り分けるため、
# frontendとbackendには別々のFQDNを指定します。
frontend_host = "app.example.com"
backend_host  = "api.example.com"

# コンテナレジストリ: AppRun pull用アカウントのパスワード
# (レジストリ本体・ci用アカウントは infra/terraform-bootstrap で管理する)
registry_apprun_user_password = "registry_apprun_user_password"
